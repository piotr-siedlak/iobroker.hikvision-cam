{
  "type": "tabs",
  "i18n": true,
  "items": {
    "_camerasTab": {
      "type": "panel",
      "label": "Cameras",
      "items": {
        "_help": {
          "type": "staticText",
          "text": "Add one card per camera with the + button. Fill in name, address and login, then press Test connection. Detection rules (line crossing, intrusion, ...) are configured in the camera itself; this adapter only listens.",
          "newLine": true,
          "xs": 12
        },
        "cameras": {
          "type": "table",
          "label": "Cameras",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "noDelete": false,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Enabled",
              "default": true
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name"
            },
            {
              "type": "select",
              "attr": "mode",
              "title": "Mode",
              "default": "stream",
              "tooltip": "Stream: the adapter connects to the camera (recommended). Push: the camera sends alerts to the adapter's push listener",
              "options": [
                {
                  "label": "Stream",
                  "value": "stream"
                },
                {
                  "label": "Push",
                  "value": "push"
                }
              ]
            },
            {
              "type": "text",
              "attr": "host",
              "title": "IP address or host"
            },
            {
              "type": "select",
              "attr": "protocol",
              "title": "Protocol",
              "default": "http",
              "options": [
                {
                  "label": "HTTP",
                  "value": "http"
                },
                {
                  "label": "HTTPS",
                  "value": "https"
                }
              ]
            },
            {
              "type": "number",
              "attr": "port",
              "title": "Port",
              "default": 80,
              "min": 1,
              "max": 65535
            },
            {
              "type": "text",
              "attr": "username",
              "title": "User"
            },
            {
              "type": "password",
              "attr": "password",
              "title": "Password"
            },
            {
              "type": "sendTo",
              "attr": "_test",
              "title": "Test",
              "label": "Test connection",
              "command": "testConnection",
              "jsonData": "{\"name\":\"${data.name}\",\"host\":\"${data.host}\",\"protocol\":\"${data.protocol}\",\"port\":\"${data.port}\",\"username\":\"${data.username}\",\"password\":\"${data.password}\",\"authMode\":\"${data.authMode}\",\"verifyTls\":\"${data.verifyTls}\",\"mode\":\"${data.mode}\"}",
              "showProcess": true,
              "timeout": 30000,
              "variant": "outlined",
              "icon": "search"
            },
            {
              "type": "select",
              "attr": "authMode",
              "title": "Authentication",
              "default": "digest",
              "options": [
                {
                  "label": "Digest (recommended)",
                  "value": "digest"
                },
                {
                  "label": "Basic",
                  "value": "basic"
                }
              ],
              "tooltip": "Basic sends the password unencrypted over HTTP; use only if the camera offers nothing else"
            },
            {
              "type": "checkbox",
              "attr": "verifyTls",
              "title": "Verify TLS certificate",
              "default": true,
              "tooltip": "Untick only for cameras with a self-signed certificate"
            },
            {
              "type": "checkbox",
              "attr": "snapshot",
              "title": "Snapshot on trigger",
              "default": false,
              "tooltip": "Fetch one JPEG from the camera for each new trigger and keep the latest in the adapter file storage"
            },
            {
              "type": "number",
              "attr": "alarmTimeout",
              "title": "Alarm timeout (s)",
              "default": 5,
              "min": 1,
              "max": 3600,
              "tooltip": "Clears an active alarm that the camera stops refreshing (cameras that never send inactive)"
            },
            {
              "type": "number",
              "attr": "reconnectInterval",
              "title": "Reconnect interval (s)",
              "default": 5,
              "min": 1,
              "max": 3600
            },
            {
              "type": "number",
              "attr": "streamTimeout",
              "title": "Stream inactivity timeout (s)",
              "default": 60,
              "min": 15,
              "max": 3600,
              "tooltip": "Reconnect when no data or heartbeat arrives for this long (armed after the first data)"
            },
            {
              "type": "text",
              "attr": "eventFilter",
              "title": "Ignore events (comma separated)",
              "tooltip": "Normalized or raw names, e.g. motion,vmd"
            },
            {
              "type": "checkbox",
              "attr": "discoverUnknown",
              "title": "Create unknown event types",
              "default": true
            },
            {
              "type": "checkbox",
              "attr": "diagnostic",
              "title": "Log raw payloads (diagnostic)",
              "default": false
            }
          ],
          "encryptedAttributes": [
            "password"
          ],
          "useCardFor": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "titleAttribute": "name",
          "clone": true,
          "compact": true
        }
      }
    },
    "_discoverTab": {
      "type": "panel",
      "label": "Discover",
      "items": {
        "_d0": {
          "type": "staticText",
          "newLine": true,
          "xs": 12,
          "text": "Scan a subnet for Hikvision cameras and add all of them with the same login. Save your settings first: after a successful scan the new cameras are saved and this page reloads."
        },
        "scanSubnet": {
          "type": "text",
          "label": "Subnet or range",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "default": "",
          "help": "e.g. 192.168.1.0/24 or 192.168.1.10-60 (private addresses only, max 1024)"
        },
        "scanProtocol": {
          "type": "select",
          "label": "Protocol",
          "xs": 6,
          "sm": 6,
          "md": 3,
          "default": "http",
          "options": [
            {
              "label": "HTTP",
              "value": "http"
            },
            {
              "label": "HTTPS",
              "value": "https"
            }
          ]
        },
        "scanPort": {
          "type": "number",
          "label": "Port",
          "xs": 6,
          "sm": 6,
          "md": 3,
          "min": 1,
          "max": 65535,
          "default": 80
        },
        "scanUser": {
          "type": "text",
          "label": "User",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "default": ""
        },
        "scanPassword": {
          "type": "password",
          "label": "Password",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "default": ""
        },
        "_scan": {
          "type": "sendTo",
          "label": "Scan and add cameras",
          "command": "discover",
          "jsonData": "{\"subnet\":\"${data.scanSubnet}\",\"protocol\":\"${data.scanProtocol}\",\"port\":\"${data.scanPort}\",\"username\":\"${data.scanUser}\",\"password\":\"${data.scanPassword}\"}",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "showProcess": true,
          "timeout": 150000,
          "reloadBrowser": true,
          "variant": "contained",
          "icon": "search"
        },
        "lastScanResult": {
          "type": "text",
          "label": "Last scan",
          "newLine": true,
          "xs": 12,
          "readOnly": true,
          "minRows": 2,
          "maxRows": 6,
          "default": ""
        },
        "_d1": {
          "type": "staticText",
          "newLine": true,
          "xs": 12,
          "text": "Each address gets one read-only request with HTTP Digest login; devices that reject the login are listed but not added. Cameras that are already configured are skipped."
        }
      }
    },
    "_optionsTab": {
      "type": "panel",
      "label": "Options",
      "items": {
        "historySize": {
          "type": "number",
          "label": "Trigger history size",
          "min": 0,
          "max": 200,
          "default": 20,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "help": "Recent triggers kept per camera in lastEvent.history (0 = off)"
        }
      }
    },
    "_pushTab": {
      "type": "panel",
      "label": "Push listener",
      "items": {
        "_p0": {
          "type": "staticText",
          "newLine": true,
          "xs": 12,
          "text": "Optional. Only used by cameras whose mode is Push. Stream mode is recommended: it detects lost connections, push mode cannot."
        },
        "pushPort": {
          "type": "number",
          "label": "Listener port",
          "min": 1,
          "max": 65535,
          "default": 8089,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "pushBind": {
          "type": "ip",
          "label": "Listen on address",
          "listenOnAllPorts": true,
          "default": "0.0.0.0",
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "_p1": {
          "type": "staticText",
          "newLine": true,
          "xs": 12,
          "text": "Camera: Configuration > Network > Advanced Settings > Alarm Server (HTTP Listening): destination IP = this ioBroker host, URL = /, port = listener port, protocol HTTP. Then tick 'Notify Surveillance Center' in each rule's linkage."
        },
        "_p2": {
          "type": "staticText",
          "newLine": true,
          "xs": 12,
          "text": "Only requests from the IP addresses of configured push cameras are accepted. Keep the port reachable from the camera network only."
        }
      }
    },
    "_setupTab": {
      "type": "panel",
      "label": "Camera setup",
      "items": {
        "_h1": {
          "type": "header",
          "text": "Before adding a camera",
          "size": 4,
          "newLine": true
        },
        "_s1": {
          "type": "staticText",
          "text": "1. In the camera web UI, for every rule you want to receive (Event > Smart Event / Basic Event), open Linkage Method and tick 'Notify Surveillance Center'. Enabling a rule alone does not send it over ISAPI.",
          "newLine": true,
          "xs": 12
        },
        "_s2": {
          "type": "staticText",
          "text": "2. Create a camera user with remote notification / alarm permission. Administrator rights are not needed.",
          "newLine": true,
          "xs": 12
        },
        "_s3": {
          "type": "staticText",
          "text": "3. Check access from the ioBroker host: curl --digest -N -u USER 'http://CAMERA_IP/ISAPI/Event/notification/alertStream' (curl asks for the password). Events and a heartbeat should appear.",
          "newLine": true,
          "xs": 12
        },
        "_s4": {
          "type": "staticText",
          "text": "The adapter is read-only: it never changes detection rules, schedules, linkage or network settings.",
          "newLine": true,
          "xs": 12
        }
      }
    }
  }
}
